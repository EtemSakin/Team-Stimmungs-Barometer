# Mandatory long random production secret; never commit real secrets.
DJANGO_SECRET_KEY=replace-with-unique-long-random-secret
DJANGO_DEBUG=1
# Comma-separated domains for Django's Host validation.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Only enable SSL redirect with a trusted HTTPS reverse proxy.
DJANGO_SSL_REDIRECT=0
DATABASE_PATH=db.sqlite3
